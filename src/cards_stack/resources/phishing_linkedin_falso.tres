[resource]
script = ExtResource("1_4hrsr")
card_color = Color(0.85, 0.3, 0.3, 1)
card_title = "💼 Tienes una nueva conexión (revisar remitente)"
subject = "María González quiere conectar contigo — remitente: notifications@linkedin-corp.net"
sender_name = "LinkedIn"
sender_email = "notifications@linkedin-corp.net"
email_body = "Hola,

María González (Gerente de Recursos Humanos en TechCorp)
quiere conectar contigo en LinkedIn.

Ver perfil completo: [Haz clic aquí]

Por razones de seguridad, confirma tu identidad iniciando sesión:

Usuario: _______
Contraseña: _______

Si no conoces a esta persona, ignora este mensaje.

Equipo de LinkedIn"
is_phishing = true
difficulty = 3
points_correct = 125
points_incorrect = -60
phishing_indicators = Array[String](["Dominio falso: linkedin-corp.net (real es linkedin.com)", "Solicita usuario y contraseña por email", "LinkedIn NUNCA pide contraseñas en correos", "Enlace genérico sin personalización"])
explanation = "¡PHISHING SOFISTICADO! Intento de robo de credenciales:
- Dominio falso muy convincente (linkedin-corp.net vs linkedin.com)
- LinkedIn NUNCA solicita contraseñas por email
- Usa ingeniería social (oferta de trabajo/conexión profesional)
- Los emails reales de LinkedIn tienen tu nombre y enlaces verificados
- Intenta capturar credenciales directamente"
card_id = "phishing_003"
category = "social_media"
