# Clippy Assistant - Spanish Translation
# Godot 4.5+ .po format
# 
# Este archivo contiene todas las cadenas traducibles del asistente Clippy
# Cargar en Godot via Project Settings > Localization

msgid ""
msgstr ""
"Language: es\n"
"Content-Type: text/plain; charset=UTF-8\n"

# Mensajes de error
msgid "CLIPPY_ERROR_INVALID_EVENT"
msgstr "Recibí un evento inválido. Por favor verifica la configuración del evento."

msgid "CLIPPY_ERROR_WRONG_ANSWER"
msgstr "No es del todo correcto. Revisa la información cuidadosamente e intenta nuevamente."

msgid "CLIPPY_ERROR_TIMEOUT"
msgstr "¡Se acabó el tiempo! No te preocupes, puedes intentarlo de nuevo."

msgid "CLIPPY_ERROR_INVALID_INPUT"
msgstr "Esa entrada no parece válida. Verifica el formato requerido e intenta de nuevo."

msgid "CLIPPY_ERROR_GENERIC"
msgstr "Algo salió mal. Tómate un momento para revisar el desafío."

msgid "CLIPPY_ERROR_HINT_SUGGESTION"
msgstr "¿Necesitas ayuda? Intenta usar el botón de pista para obtener orientación."

msgid "CLIPPY_ERROR_CHALLENGE_FAILED"
msgstr "Ese desafío no salió como queríamos. Revisa las pistas y vuelve a intentarlo."

msgid "CLIPPY_ERROR_NAVIGATION_BLOCKED"
msgstr "La navegación está pausada mientras hay un desafío activo. Termínalo o cancélalo para seguir avanzando."

msgid "CLIPPY_ERROR_GAME_OVER"
msgstr "Esta partida terminó, pero cada intento deja aprendizaje. Respira y vuelve a intentarlo."

# Mensajes de tutorial
msgid "CLIPPY_TUTORIAL_START"
msgstr "¡Bienvenido! Déjame mostrarte lo básico:"

msgid "CLIPPY_TUTORIAL_GENERIC"
msgstr "Sigue las instrucciones en pantalla para comenzar."

# Mensajes de minijuegos
msgid "CLIPPY_MINIGAME_START"
msgstr "¡Iniciando desafío de {game}!"

msgid "CLIPPY_MINIGAME_GENERIC"
msgstr "Es hora de probar tus habilidades en {game}. ¡Buena suerte!"

msgid "CLIPPY_MINIGAME_EMAIL_INTRO"
msgstr "📧 Email Phishing Detector está activo."

msgid "CLIPPY_MINIGAME_EMAIL_OBJECTIVE"
msgstr "Analiza remitente, asunto y cuerpo para etiquetar cada mensaje como seguro o phishing."

msgid "CLIPPY_MINIGAME_EMAIL_TIP"
msgstr "Pasa el cursor por los enlaces sospechosos y compara dominios; los servicios legítimos no mezclan caracteres al azar."

msgid "CLIPPY_MINIGAME_PORT_SCANNER_INTRO"
msgstr "🛰 Port Scanner Defender se está iniciando."

msgid "CLIPPY_MINIGAME_PORT_SCANNER_OBJECTIVE"
msgstr "Asocia cada servicio con el rango de puertos correcto antes de que acabe el tiempo."

msgid "CLIPPY_MINIGAME_PORT_SCANNER_TIP"
msgstr "Apóyate en puertos conocidos (HTTP 80/443, SSH 22) para mantener el ritmo del escaneo."

msgid "CLIPPY_MINIGAME_SQL_INJECTION_INTRO"
msgstr "🗃 El laboratorio de SQL Injection está abierto."

msgid "CLIPPY_MINIGAME_SQL_INJECTION_OBJECTIVE"
msgstr "Revisa las consultas y sanitiza cada entrada para bloquear las cargas maliciosas."

msgid "CLIPPY_MINIGAME_SQL_INJECTION_TIP"
msgstr "Rechaza entradas con sentencias apiladas o comillas sin escapar; suelen indicar un intento de inyección."

msgid "CLIPPY_MINIGAME_PASSWORD_CRACKER_INTRO"
msgstr "🔐 Password Cracker Simulator en marcha."

msgid "CLIPPY_MINIGAME_PASSWORD_CRACKER_OBJECTIVE"
msgstr "Combina las pistas para adivinar la contraseña antes de agotar los intentos."

msgid "CLIPPY_MINIGAME_PASSWORD_CRACKER_TIP"
msgstr "Empieza con sustituciones obvias y luego escala a patrones de fuerza bruta más amplios."

msgid "CLIPPY_MINIGAME_NETWORK_DEFENDER_INTRO"
msgstr "🌐 Network Defender está en línea."

msgid "CLIPPY_MINIGAME_NETWORK_DEFENDER_OBJECTIVE"
msgstr "Vigila los canales de tráfico y redirige los paquetes sospechosos antes de que toquen el núcleo."

msgid "CLIPPY_MINIGAME_NETWORK_DEFENDER_TIP"
msgstr "Prioriza las anomalías en puertos poco usados; suelen ocultar el vector de ataque."

msgid "CLIPPY_MINIGAME_PASSWORD_STRENGTH_INTRO"
msgstr "🔑 Password Strength Trainer listo."

msgid "CLIPPY_MINIGAME_PASSWORD_STRENGTH_OBJECTIVE"
msgstr "Evalúa la robustez de cada contraseña y sugiere mejoras."

msgid "CLIPPY_MINIGAME_PASSWORD_STRENGTH_TIP"
msgstr "Promueve frases largas con símbolos variados; la aleatoriedad supera a las palabras ingeniosas."

# Mensajes de progreso
msgid "CLIPPY_PROGRESS_HIGH"
msgstr "¡Excelente progreso! Casi llegas a la meta."

msgid "CLIPPY_PROGRESS_MID"
msgstr "¡Vas a la mitad! Sigue con el buen trabajo."

msgid "CLIPPY_PROGRESS_LOW"
msgstr "¡Buen comienzo! Continúa explorando para avanzar más."

msgid "CLIPPY_PROGRESS_VISIT_START"
msgstr "Regresaste al nodo raíz {node}. Úsalo para planear la siguiente rama."

msgid "CLIPPY_PROGRESS_VISIT_CHALLENGE"
msgstr "Llegaste al nodo de desafío {node}. Lanza la app cuando estés listo para enfrentarlo."

msgid "CLIPPY_PROGRESS_VISIT_HINT"
msgstr "El nodo de pista {node} reveló nueva información. Revisa las rutas desbloqueadas."

msgid "CLIPPY_PROGRESS_VISIT_FINAL"
msgstr "El nodo meta {node} está al alcance. Completa el reto cercano para finalizar la partida."

msgid "CLIPPY_PROGRESS_VISIT_GENERIC"
msgstr "Progreso registrado en {node}. Sigue escalando el árbol."

msgid "CLIPPY_PROGRESS_DISCOVERED_NODE"
msgstr "Descubriste una nueva rama en {node}. Explora sus hijos para avanzar."

msgid "CLIPPY_PROGRESS_SCORE_HINT"
msgstr "¡Pista asegurada! +{delta} pts (total {score}). Úsala para definir el siguiente paso."

msgid "CLIPPY_PROGRESS_SCORE_CHALLENGE"
msgstr "Explorar ese desafío te dio +{delta} pts. La racha continúa (puntaje {score})."

msgid "CLIPPY_PROGRESS_SCORE_FINAL"
msgstr "El avance hacia la meta otorgó +{delta} pts. Ya tienes {score}; la victoria está cerca."

msgid "CLIPPY_PROGRESS_SCORE_GENERIC"
msgstr "El puntaje aumentó +{delta} ({reason}). Total actual: {score}."

msgid "CLIPPY_NODE_UNKNOWN_LABEL"
msgstr "este nodo"

# Mensajes de logros
msgid "CLIPPY_ACHIEVEMENT"
msgstr "¡Logro desbloqueado: {achievement}! ¡Excelente trabajo!"

# Navegación de nodos
msgid "CLIPPY_NODE_ENTERED"
msgstr "Has alcanzado el nodo: {node}"

# Pistas
msgid "CLIPPY_HINT_GENERIC"
msgstr "Piensa cuidadosamente sobre la información presentada. Busca patrones y detalles inusuales."

# Completar juego
msgid "CLIPPY_GAME_COMPLETED"
msgstr "¡Felicitaciones! Has completado el juego. ¡Excelente trabajo dominando estos conceptos de ciberseguridad!"

# Mensajes de virus
msgid "CLIPPY_VIRUS_INFECTED"
msgstr "⚠️ **{virus_name} detectado!**\n\n{help_text}"

msgid "CLIPPY_VIRUS_CLEARED"
msgstr "✅ **¡Excelente!** Has eliminado el {virus_name} exitosamente. ¡Buen trabajo!"

msgid "CLIPPY_VIRUS_FAILED_CRITICAL"
msgstr "💀 **¡CRÍTICO!** Has fallado {failed_count}/{max_failures} virus. ¡El siguiente fallo es GAME OVER!"

msgid "CLIPPY_VIRUS_FAILED_WARNING"
msgstr "⚠️ **Advertencia:** Has fallado {failed_count}/{max_failures} virus. Solo te queda {remaining} oportunidad más."

msgid "CLIPPY_VIRUS_FAILED_NORMAL"
msgstr "❌ Fallaste al eliminar el virus. Llevas {failed_count}/{max_failures} fallos. Te quedan {remaining} oportunidades."

# Ayuda para cada tipo de virus
msgid "CLIPPY_VIRUS_HELP_FAKE_UPDATE"
msgstr "¡Cuidado! Este virus simula una actualización falsa de Windows.\n\n**Cómo eliminar:** Cancela la instalación antes de que se complete. No presiones 'Instalar' - ¡es una trampa!"

msgid "CLIPPY_VIRUS_HELP_CAPTCHA"
msgstr "Este virus presenta CAPTCHAs imposibles o engañosos.\n\n**Cómo eliminar:** Intenta resolver el CAPTCHA correctamente. Tienes 3 intentos - ¡piensa bien antes de verificar!"

msgid "CLIPPY_VIRUS_HELP_SURVEY"
msgstr "Un virus disfrazado de encuesta que intenta robar tus datos.\n\n**Cómo eliminar:** Responde solo las preguntas seguras. Evita compartir información personal sensible."

msgid "CLIPPY_VIRUS_HELP_GLITCH"
msgstr "Virus de fragmentación que desordena tu pantalla.\n\n**Cómo eliminar:** Reorganiza los fragmentos en el orden correcto antes de que se acabe el tiempo."

msgid "CLIPPY_VIRUS_HELP_ADWARE"
msgstr "Ventanas emergentes molestas que se multiplican.\n\n**Cómo eliminar:** Cierra todas las ventanas de publicidad sin hacer clic en los anuncios."

msgid "CLIPPY_VIRUS_HELP_PHISHING"
msgstr "Virus que imita mensajes legítimos para engañarte.\n\n**Cómo eliminar:** Identifica el mensaje falso y márcalo como spam."

msgid "CLIPPY_VIRUS_HELP_DEFAULT"
msgstr "Se ha detectado un virus. ¡Elimínalo rápidamente!"

