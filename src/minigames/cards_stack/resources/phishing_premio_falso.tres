points_correct = 75
points_incorrect = -40
phishing_indicators = Array[String](["Identificador sospechoso con extensión .xyz", "Solicita pago de 'impuestos' por adelantado", "Pide información personal sensible", "No participaste en ningún sorteo", "Urgencia para evitar que pienses"])
explanation = "¡PHISHING CLÁSICO! Estafa de 'premio falso':
- Identificador no oficial (.xyz es bandera roja)
- Solicita pagar para recibir premio (los premios reales no requieren pago)
- Pide datos personales sensibles
- No hay forma legítima de haber participado en este sorteo
- Crea urgencia falsa (48 horas)"
card_id = "phishing_002"
