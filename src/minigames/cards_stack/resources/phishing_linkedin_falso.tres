[resource]
script = ExtResource("1_4hrsr")
card_color = Color(0.85, 0.3, 0.3, 1)
card_title = "💼 Tienes una nueva conexión"
notification_title = "notifications@linkin-corp.net"
app_name = "LinkedIn"
app_identifier = "net.linkedin-corp"
notification_message = "Hola,

María González (Gerente de Recursos Humanos en TechCorp)
quiere conectar contigo en LinkedIn.

Ver perfil completo: [Haz clic aquí]

Por razones de seguridad, confirma tu identidad iniciando sesión:

Usuario: _______
Contraseña: _______

Si no conoces a esta persona, ignora este mensaje.

Equipo de LinkedIn"
is_phishing = true
difficulty = 3
points_correct = 125
points_incorrect = -60
phishing_indicators = Array[String](["Identificador falso: linkedin-corp.net (real es com.linkedin.android)", "Solicita usuario y contraseña por notificación", "LinkedIn NUNCA pide contraseñas en notificaciones", "Enlace genérico sin personalización"])
explanation = "¡PHISHING SOFISTICADO! Intento de robo de credenciales:
- Identificador falso muy convincente (linkedin-corp.net vs com.linkedin.android)
- LinkedIn NUNCA solicita contraseñas por notificación
- Usa ingeniería social (oferta de trabajo/conexión profesional)
- Las notificaciones reales de LinkedIn tienen tu nombre y enlaces verificados
- Intenta capturar credenciales directamente"
card_id = "phishing_003"
category = "social_media"
