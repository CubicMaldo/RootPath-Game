; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="EstructuraDatosII"
run/main_scene="uid://bd6sncl22y8db"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/fullsize=false
boot_splash/image="uid://y2vcy8l8hge0"
config/icon="res://icon.svg"

[autoload]

Global="*res://src/autoloads/Global.gd"
EventBus="*res://src/autoloads/EventBus.gd"
SettingsManager="*res://src/autoloads/SettingsManager.gd"
SignalLens="*res://addons/signal_lens/autoload/signal_lens_autoload.gd"
Clippy="*res://src/clippy/ClippyController.gd"
ClippyBridge="*res://src/clippy/ClippyEventBridge.gd"
VirusController="*res://src/autoloads/VirusController.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/resizable=false
window/size/window_width_override=1080
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="EstructuraDatosII"

[editor_plugins]

enabled=PackedStringArray("res://addons/signal_lens/plugin.cfg", "res://addons/gut/plugin.cfg")

[gui]

theme/default_font_multichannel_signed_distance_field=true

[internationalization]

locale/translations=PackedStringArray("res://src/clippy/clippy_locales/en.po", "res://src/clippy/clippy_locales/es.po")
locale/default_locale="es"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
